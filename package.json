{
  "name": "eve-status-perception",
  "productName": "EVE Status Perception",
  "version": "1.1.6",
  "description": "EVE Online skill training and wallet status tray app",
  "main": "main.js",
  "author": {
    "name": "Bezekira Windfury",
    "email": "Temar9811@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.esp.app",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "test/**",
      "assets/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "version.js",
      "storage.js",
      "scopes.js",
      "eve.js",
      "eve/**/*",
      "main/**/*",
      "renderer/**/*",
      "test/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}