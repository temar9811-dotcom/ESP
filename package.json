{
  "name": "eve-status-perception",
  "productName": "EVE Status Perception",
  "version": "1.2.3",
  "description": "EVE Online skill training and wallet status tray app",
  "main": "main.js",
  "author": {
    "name": "Bezekira Windfury"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite ui",
    "build:ui": "vite build ui",
    "start": "electron .",
    "build": "npm run build:ui && electron-builder",
    "dist": "npm run build:ui && electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.esp.app",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "test/**/*",
      "assets/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "version.js",
      "storage.js",
      "scopes.js",
      "eve.js",
      "eve/**/*",
      "main/**/*",
      "ui/dist/**/*",
      "test/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  }
}